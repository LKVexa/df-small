#!/bin/sh
# DF_Small/VERIFY -- hashes, manifest, schemas, citations, core selfcheck, the VM's own gate (scratch copy), the adapter battery
# Offline. Nothing here opens a socket (NETWORK=deny, BACKEND=none).
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT"
PY="${PYTHON:-python3}"
exec "$PY" -B adapter/dfabric/cli.py node-verify "$@"
